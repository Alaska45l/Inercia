# Inercia alpha local configuration.
# Missing AI keys are allowed; deterministic fallbacks keep the pipeline usable.
GEMINI_API_KEY=

# Local state.
UPWORK_SESSION_DIR=.upwork-session
DB_PATH=inercia.db

# Safety limits and local ports.
DAILY_PROPOSAL_CAP=12
WS_PORT=9741
LOGIN_DEBUG_PORT=9742
FLOOR_HOURLY_RATE=35
FLOOR_FIXED_RATE=50
ALLOW_UPWORK_NETWORK=false
SCHEDULER_INTERVAL_MIN_MINUTES=5
SCHEDULER_INTERVAL_MAX_MINUTES=15

# JSON runtime settings. The UI can also store these in the SQLite sessions table.
blacklist_keywords='["wordpress","wix","shopify","squarespace","bigcommerce","elementor","divi","webflow","woocommerce","magento","prestashop","joomla","drupal","godaddy","weebly","php developer","theme customization","plugin development"]'
upwork_search_filters='{"categories":[],"experience_levels":["Intermediate","Expert"],"job_types":["Hourly","Fixed"],"budget_min":null,"budget_max":null,"hourly_rate_min":null,"hourly_rate_max":null,"hours_per_week":[],"project_lengths":[],"client_history":[],"client_location":"","proposals":[],"max_connects":16}'
portfolio_attachments='[]'
